# Playwright E2E environment variables
# Copy this file to .env.e2e and adjust for your environment.

# Local dev (default): points to the Vite dev server or a local NestJS backend
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Separate API base URL for direct API calls in tests (globalSetup seeding, status verification).
# Defaults to PLAYWRIGHT_BASE_URL if not set. Use this when the API is on a different port.
# E2E_API_BASE_URL=http://localhost:7100

# CI / staging: override via CI secrets or .env.e2e.local
# PLAYWRIGHT_BASE_URL=https://staging.okfootwear.com
